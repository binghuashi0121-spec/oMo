.page {
  background-color: #ffffff;
  /* background-image: url('/pictures/shouye/background.png'); */
  /* background-size: 100% 100%; */
  background-repeat: no-repeat;
  width: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  height: 100%;
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
  /* 定义颜色变量，便于后续调整 */
  --bg-start-color: #FFA500;
  --bg-end-color: #FFFFFF;
  --map-border-color: #000000;
}

.section {
  /* background-image: url('../../pictures/shouye/background.png'); */
  /* background: linear-gradient(to top, var(--bg-start-color), var(--bg-end-color)); */
  background-image: linear-gradient(180deg, #e0d4c333 3.4%, #f3a48733 51.4%, #ef5b2433 100%);
  /* background-size: 100% 100%; */
  background-repeat: no-repeat;
  width: 750rpx;
  height: 1625.95rpx;
  position: relative;
}

.top-logo {
  position: absolute;
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  z-index: 5;
}

.section-bg {
  display: none;
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

