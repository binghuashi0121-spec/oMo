  height: 45.8rpx;
}

.group_2 {
  margin-top: -7.63rpx;
  padding-top: 50.27rpx;
}

.text_3 {
  color: #9a9a9a;
}

.image_3 {
  border-radius: 50%;
  width: 70.61rpx;
  height: 70.61rpx;
}

.pos_3 {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.blurred {
  filter: blur(4px);
  transition: filter 300ms ease;
}

.map-frame {
  position: absolute;
  top: 180rpx;
  left: 35rpx;
  width: 680rpx;
  height: 940rpx;
  border-radius: 48rpx;
  overflow: hidden;
  z-index: 0;
  border: 4px solid var(--map-border-color);
  box-sizing: border-box;
}

.map-inner {
  width: 100%;
  height: 100%;
}

.map-component {
  width: 100%;
  height: 100%;
}

.car-status-panel {
  position: absolute;
  right: 20rpx;
  top: 40rpx;
  padding: 16rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  min-width: 220rpx;
  max-width: 260rpx;
  z-index: 10;
}

.car-status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 8rpx;
}

.car-status-row:last-child {
  margin-bottom: 0;
}

.car-status-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 8rpx;
  font-weight: 600;
}

.car-status-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 700;
}

.placeholder-content {
  text-align: center;
}

.placeholder-text {
  font-size: 32rpx;
  color: #999999;
  font-family: Inter;
}

.first-tap-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 90;
}

.login-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  flex-direction: column;
}

.login-loader {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #ffffff;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.login-tip {
  font-size: 30rpx;
  color: #ffffff;
}

.suspended-trip-entry {
  position: fixed;
  right: 28rpx;
  bottom: 330rpx;
  z-index: 96;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 20rpx 14rpx 14rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(239, 91, 36, 0.25);
}

.suspended-trip-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
}

.suspended-trip-text-wrap {
  display: flex;
  flex-direction: column;
}

.suspended-trip-title {
  color: #ef5b24;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.suspended-trip-subtitle {
  margin-top: 4rpx;
  color: #444444;
  font-size: 20rpx;
  line-height: 1.2;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
