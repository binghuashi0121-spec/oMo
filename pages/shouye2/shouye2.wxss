}

.font {
  font-size: 38.17rpx;
  font-family: Inter;
  line-height: 35.5rpx;
  color: #ffffff;
}

.text-wrapper_2 {
  padding: 36.45rpx 0 33.05rpx;
  background-color: #ef5b24;
  border-radius: 17.18rpx;
  width: 318.7rpx;
  z-index: 2;
}

.pos_2 {
  position: absolute;
  right: 38.17rpx;
  top: 1246.18rpx;
}

.text {
  line-height: 35.46rpx;
}

.equal-division {
  position: absolute;
  left: 40.08rpx;
  right: 38.17rpx;
  top: 1391.22rpx;
  z-index: 1;
}

.section_2 {
  padding: 20.88rpx 0 21.97rpx;
  background-color: #f5f5f5;
  border-radius: 38.17rpx;
}

.group {
  flex: 1 1 330.8rpx;
}

.group_1 {
  padding: 10rpx 0 14.96rpx;
