.image {
  width: 74.43rpx;
  height: 73.24rpx;
}

.font_2 {
  font-size: 28.63rpx;
  font-family: Inter;
  line-height: 26.55rpx;
}

.text_2 {
  color: #fc9063;
}

.group_4 {
  padding: 13.47rpx 0 10rpx;
}

.image_2 {
  border-radius: 50%;
