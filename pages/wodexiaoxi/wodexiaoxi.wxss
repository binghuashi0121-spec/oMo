/* Base Page Structure */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f4f0eb;
  overflow: hidden;
  padding-top: 66.79rpx; /* Match original padding */
  box-sizing: border-box;
}

/* --- Preserved Header Styles --- */
.section {
  margin-left: 38.17rpx;
  margin-right: 40.08rpx;
  padding: 15.27rpx 40.08rpx 45.8rpx;
  background-image: linear-gradient(268.8deg, #eadcdc 9.6%, #f7dbbe 97.4%);
  border-radius: 76.34rpx;
  flex-shrink: 0; /* Prevent header from shrinking */
}

.image-wrapper {
  padding: 28.63rpx 0 22.9rpx;
  background-color: #efe7dc;
  border-radius: 1906.49rpx;
  width: 110.69rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.image {
  width: 45.8rpx;
  height: 45.8rpx;
}

.image_2 {
  width: 438.93rpx;
  height: 154.58rpx;
  align-self: center;
}

.tap-press {
  opacity: 0.8;
  transform: scale(0.95);
}

/* --- New Content Styles --- */

/* Filter Bar */
.filter-bar {
  display: flex;
  padding: 20rpx 32rpx;
  background: transparent;
  gap: 20rpx;
  flex-shrink: 0;
}

.filter-item {
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-item.active {
  background: #FF5A5F;
  color: #ffffff;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 90, 95, 0.3);
}

/* Message List Scroll Area */
.message-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx; /* 16px left/right padding */
  box-sizing: border-box;
}

.message-wrapper {
  padding-bottom: 120rpx; /* Space for bottom bar */
}

/* Message Card */
.message-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  position: relative;
  transition: all 0.2s;
}

.message-card.selected {
  background: #fff5f5;
  border: 2rpx solid #FF5A5F;
}

.checkbox-wrapper {
  margin-right: 20rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #FF5A5F;
  border-color: #FF5A5F;
  position: relative;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  width: 16rpx;
  height: 8rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sender-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sender-name {
  font-size: 28rpx; /* 14px */
  font-weight: bold;
  color: #333;
}

.red-dot {
  width: 16rpx; /* 8px */
  height: 16rpx;
  background: #FF5A5F;
  border-radius: 50%;
}

.timestamp {
  font-size: 20rpx; /* 10px */
  color: #999;
}

.message-preview {
  font-size: 24rpx; /* 12px */
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Loading & Empty States */
.loading-state {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100rpx;
  color: #999;
  font-size: 28rpx;
}

/* Batch Action Bar */
.batch-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.batch-actions {
  display: flex;
  gap: 20rpx;
}

.batch-btn {
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #333;
}

.batch-btn.delete {
  background: #FF5A5F;
  color: white;
}

.batch-btn.cancel {
  background: transparent;
  color: #666;
}

/* Skeleton Loading */
.skeleton-container {
  padding: 0 32rpx;
}

.skeleton-card {
  background: #fff;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #f0f0f0;
  border-radius: 50%;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
}

.skeleton-line.short {
  width: 40%;
}

.skeleton-line.long {
  width: 90%;
}

/* Utility */
.oMo-flex-col {
  display: flex;
  flex-direction: column;
}

.oMo-justify-start {
  justify-content: flex-start;
}

.oMo-items-start {
  align-items: flex-start;
}

.oMo-items-center {
  align-items: center;
}

.oMo-self-stretch {
  align-self: stretch;
}

.oMo-self-center {
  align-self: center;
}
