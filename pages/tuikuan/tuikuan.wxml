<view class="oMo-flex-col oMo-relative page">
  <text class="oMo-self-end text">已退款：</text>
  <view class="oMo-flex-col oMo-self-stretch group_2">
    <view class="oMo-flex-col map-snapshot-card">
      <view class="oMo-flex-row map-snapshot-header">
        <text class="map-snapshot-title">订单结果</text>
      </view>
      <view class="oMo-flex-col map-snapshot-body">
        <map
          wx:if="{{hasRoute}}"
          id="refundRouteMap"
          class="map-snapshot-image"
          latitude="{{mapLatitude}}"
          longitude="{{mapLongitude}}"
          scale="{{mapScale}}"
          polyline="{{trackPolyline}}"
          enable-scroll="false"
          enable-zoom="false"
          enable-rotate="false"
          show-location="false"
        ></map>
        <view wx:else class="oMo-flex-col oMo-items-center oMo-justify-center map-snapshot-placeholder">
          <text class="map-snapshot-placeholder-title">地图截图加载中</text>
          <text class="map-snapshot-placeholder-desc">将在此展示本次行程的路线轨迹图</text>
        </view>
      </view>
    </view>
    <view class="oMo-flex-col section_2">
      <view class="oMo-flex-row oMo-items-center group_3">
        <image
          class="image_3"
          src="../../pictures/tuikuan/bill.png"
        />
        <text class="text_4">订单明细</text>
      </view>
      <view class="oMo-flex-col group_4 oMo-mt-10">
        <view class="oMo-flex-row oMo-justify-between">
          <text class="font">预付金额</text>
          <text class="font_2 text_5">{{deposit}}元</text>
        </view>
        <view class="oMo-flex-row oMo-justify-between">
          <text class="font">预估费用</text>
          <text class="font_2 text_6">{{totalFee}}元</text>
        </view>
        <view class="oMo-flex-row oMo-justify-between">
          <text class="font">实付费用</text>
          <text class="font_2 text_7">{{totalFee}}元</text>
        </view>
        <view class="oMo-flex-row oMo-justify-between">
          <text class="font text_1">支付流水号</text>
          <text class="font_2 text_8">{{paymentId}}</text>
        </view>
        <view class="oMo-flex-row oMo-justify-between">
          <text class="font text_15">订单编号</text>
          <text class="font_2 text_9">{{tripId}}</text>
        </view>
        <view class="oMo-flex-row oMo-justify-between">
          <text class="font">订单类型</text>
          <text class="font_2 text_10">OMO共享车</text>
        </view>
        <view class="oMo-flex-row oMo-justify-between">
          <text class="font">订单状态</text>
          <text class="font_2 text_11">已完成</text>
        </view>
      </view>
    </view>
    <view class="oMo-flex-col oMo-justify-start oMo-items-center text-wrapper mt-73" bind:tap="onClick">
      <text class="text_12">确定</text>
    </view>
  </view>
  <view class="oMo-flex-col oMo-justify-start group pos">
    <view class="oMo-flex-col section">
      <text class="oMo-self-end text_2">￥{{refund}}</text>
      <text class="oMo-self-start text_3 oMo-mt-24">智能漫游车</text>
    </view>
    <image
      class="image_2 pos_3"
      src="../../pictures/tuikuan/car.png"
    />
    <image
      class="image pos_2"
      src="../../pictures/tuikuan/oMo_logo.png"
    />
  </view>
</view>
