<view class="oMo-flex-col page">
  <view class="oMo-flex-col section">
    <view class="oMo-flex-row oMo-relative oMo-justify-center oMo-items-center" style="width: 100%;">
      <view class="image-wrapper pos-left" bind:tap="onConfirmTap" hover-class="tap-press">
        <image class="image-icon" src="../../pictures/tuijianshangchedian/home.png" />
      </view>

      <image class="image-logo" src="../../pictures/tuijianshangchedian/oMo_logo.png" />

      <view class="image-wrapper pos-right" bind:tap="onClick" hover-class="tap-press">
        <image class="image-icon" src="../../pictures/tuijianshangchedian/help_center.png" />
      </view>
    </view>
  </view>

  <view class="map-selection-card" bind:tap="onChooseLocation" hover-class="card-press">
    <view class="map-icon-wrapper">
      <image class="image_3" src="../../pictures/tuijianshangchedian/ditu_location.png" />
    </view>
    <view class="map-text-wrapper">
      <text class="map-title">地图选点</text>
      <text class="map-subtitle">点击打开地图选择上车位置</text>
    </view>
    <view class="arrow-icon"></view>
  </view>

  <view class="preview-card">
    <view class="preview-header">
      <view class="preview-copy">
        <text class="preview-title">地图预览</text>
        <text class="preview-subtitle">地图展示使用 GCJ-02，发送给车辆时保留路网点原始精度</text>
      </view>
      <view class="preview-badge">
        <text class="preview-badge-text">路网{{previewRouteNodeCount}}点</text>
      </view>
    </view>

    <view class="preview-map-shell">
      <map
        class="preview-map"
        latitude="{{previewLatitude}}"
        longitude="{{previewLongitude}}"
        scale="{{previewScale}}"
        markers="{{previewMarkers}}"
        polyline="{{previewPolyline}}"
        show-location="true"
      ></map>
    </view>

    <view class="preview-legend">
      <view class="legend-item">
        <view class="legend-dot legend-dot-route"></view>
        <text class="legend-text">路网点</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot legend-dot-current"></view>
        <text class="legend-text">当前位置</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot legend-dot-reference"></view>
        <text class="legend-text">参考点</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot legend-dot-selected"></view>
        <text class="legend-text">推荐点</text>
      </view>
    </view>
  </view>

  <view class="oMo-flex-col oMo-relative content-container">
    <view class="input-display">
      <view class="input-dot"></view>
      <text class="input-text">{{currentAddress}}</text>
    </view>

    <view class="distance-tip" wx:if="{{nearestDistanceText}}">
      <view class="distance-dot"></view>
      <text class="distance-text">{{nearestDistanceText}}</text>
    </view>

    <view class="recommend-section">
      <text class="section-title">推荐上车点</text>
      <scroll-view scroll-y class="list-container">
        <view
          class="list-item {{selectedIndex === index ? 'item-selected' : ''}}"
          wx:for="{{items}}"
          wx:for-item="item"
          wx:for-index="index"
          wx:key="index"
          bind:tap="onSelectSpot"
          data-index="{{index}}"
        >
          <view class="item-left">
            <image class="item-icon" src="../../pictures/tuijianshangchedian/location.png" />
            <view class="item-info">
              <view class="item-header">
                <text class="item-name">{{item.name}}</text>
                <view class="item-tag" wx:if="{{item.tag}}">
                  <text class="tag-text">{{item.tag}}</text>
                </view>
              </view>
              <text class="item-address">{{item.address}}</text>
            </view>
          </view>
          <view class="item-right">
            <text class="item-time">{{item.time}}</text>
            <text class="item-distance">{{item.distance}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="footer-btn-wrapper" bind:tap="onConfirmTap" hover-class="btn-press">
    <text class="footer-btn-text">确定</text>
  </view>
</view>
