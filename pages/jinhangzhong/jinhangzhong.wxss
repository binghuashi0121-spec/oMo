.mt-7 {
  margin-top: 13.36rpx;
}

.page {
  background-color: #f9f9f9ff;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  opacity: 0;
}

.section {
  padding: 22rpx 0 20rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 8rpx #0000000d;
  border: none;
  z-index: 20;
}

.image-wrapper,
.image-wrapper_2 {
  padding: 24rpx 0;
  background-color: #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 8rpx #0000000d;
  border: none;
  width: 96rpx;
  height: 96rpx;
}

.pos-left {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.pos-right {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.image {
  width: 48rpx;
  height: 48rpx;
}

.image_2 {
  width: 440rpx;
  height: 154rpx;
}

.font {
  letter-spacing: 0;
}

.text {
  color: #000000;
  font-size: 48rpx;
  font-family: Inter;
  font-weight: 600;
  line-height: 44rpx;
  letter-spacing: 0;
}

.section_2 {
  background-color: #ef5b24;
  border-radius: 4rpx;
  box-shadow: none;
  border: none;
  width: 244rpx;
  height: 8rpx;
}

.map-placeholder {
  width: 100%;
  height: 300px;
  background-color: #eeeeee;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 20rpx;
  position: relative;
}

.map-frame {
  width: 92%;
  height: 88%;
  border-radius: 32rpx;
  overflow: hidden;
  border: 4rpx solid #000000;
  box-sizing: border-box;
}

.map-inner,
.map-component {
  width: 100%;
  height: 100%;
}

.parking-banner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 80rpx;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  opacity: 0;
  transform: translateY(-100%);
  transition: all 0.3s ease-out;
  z-index: 5;
}

.parking-banner.show {
  opacity: 1;
  transform: translateY(0);
}

.parking-status {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #ef5b24;
  border-radius: 50%;
  margin-right: 16rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    opacity: 1;
    box-shadow: 0 0 0 0 rgba(239, 91, 36, 0.7);
  }

  70% {
    opacity: 0.7;
    box-shadow: 0 0 0 10px rgba(239, 91, 36, 0);
  }

  100% {
    opacity: 1;
    box-shadow: 0 0 0 0 rgba(239, 91, 36, 0);
  }
}

.status-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.parking-timer {
  color: #ef5b24;
  font-size: 32rpx;
  font-family: monospace;
  font-weight: bold;
}

.bottom-panel {
  flex: 1;
  background-color: #ffffff;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  margin-top: -48rpx;
  padding: 48rpx 32rpx 160rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
}

.content-card {
  background-color: #e1d0d0ff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(43, 39, 39, 0.05);
  box-shadow: 0 2rpx 8rpx rgba(11, 10, 10, 0.02);
}

.trip-timer-row {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: baseline;
}

.trip-timer-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 12rpx;
  line-height: 34rpx;
}

.trip-timer-value {
  font-size: 34rpx;
  color: #ef5b24;
  font-family: monospace;
  font-weight: 700;
  line-height: 34rpx;
  letter-spacing: 2rpx;
}

.info-grid {
  display: flex;
  justify-content: space-between;
}

.info-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.info-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
  font-family: Inter;
}

.info-value {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  font-family: Inter;
}

.info-value.highlight {
  font-size: 44rpx;
  color: #ef5b24;
  font-weight: bold;
}

.battery-row {
  display: flex;
  align-items: center;
}

.icon-battery {
  width: 40rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.divider {
  height: 2rpx;
  background-color: #f0f0f0;
  margin: 24rpx 0;
}

.temp-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.temp-info {
  display: flex;
  flex-direction: column;
}

.temp-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.temp-desc {
  font-size: 24rpx;
  color: #999;
}

.secondary-info {
  display: flex;
  justify-content: space-between;
}

.sec-item {
  font-size: 24rpx;
  color: #666;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sec-label {
  margin-bottom: 4rpx;
}

.sec-value {
  color: #333;
  font-weight: 600;
}

.action-group-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: auto;
  padding-bottom: 15px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  background-color: transparent;
  z-index: 100;
  pointer-events: none;
}

.btn-emergency,
.btn-end {
  pointer-events: auto;
  width: 120px !important;
  height: 50px !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 25px;
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  padding: 0;
  margin: 0;
  transition: transform 0.1s ease-out, box-shadow 0.1s ease-out;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.btn-emergency {
  background-color: #ef4444;
}

.btn-end {
  background-color: #1890ff;
}

.fade-in {
  animation: fadeIn 0.3s ease-out forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 100%;
  background-color: #fff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 48rpx 32rpx 68rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.modal-content.slide-up {
  transform: translateY(0);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.modal-subtitle {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 48rpx;
}

.fee-preview {
  width: 100%;
  background-color: #f9f9f9;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.fee-label {
  font-size: 30rpx;
  color: #333;
}

.fee-value {
  font-size: 48rpx;
  color: #ef5b24;
  font-weight: bold;
}

.fee-tip {
  font-size: 24rpx;
  color: #bbb;
}

.modal-actions {
  display: flex;
  width: 100%;
  gap: 24rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background-color: #ef5b24;
  color: #fff;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(255, 255, 255, 0.8);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 2000;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #eee;
  border-top-color: #ef5b24;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.scale-in {
  animation: scaleIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }

  to {
    transform: scale(1);
    opacity: 1;
  }
}

.safety-popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.safety-popup-overlay.show {
  opacity: 1;
  visibility: visible;
}

.safety-popup-content {
  width: 580rpx;
  background-color: #efe7dc;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  transform: scale(0.9);
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.safety-popup-overlay.show .safety-popup-content {
  transform: scale(1);
}

.safety-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
}

.safety-text-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.safety-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.6;
  text-align: center;
  font-family: Inter;
}

.safety-btn {
  width: 240rpx;
  height: 80rpx;
  background-color: #ef5b24;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.safety-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.popup-overlay.show {
  display: flex;
  animation: fadeIn 0.2s ease-out;
}

.popup-content {
  width: 580rpx;
  background-color: #efe7dc;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.popup-image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

.popup-text-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
  text-align: center;
}

.popup-text {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.5;
  font-family: Inter;
}

.popup-timer {
  font-size: 64rpx;
  color: #ef5b24;
  font-weight: 600;
  margin-top: 24rpx;
  font-family: monospace;
}

.popup-button {
  width: 100%;
  height: 96rpx;
  background-color: #ef5b24;
  border-radius: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: opacity 0.2s;
}

.popup-button-text {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
}

@media (max-width: 375px) {
  .image_2 {
    width: 380rpx;
    height: 133rpx;
  }

  .bottom-panel {
    padding: 40rpx 24rpx 150rpx;
  }

  .content-card {
    padding: 28rpx 20rpx;
  }

  .action-group-fixed {
    gap: 14px;
  }

  .btn-emergency,
  .btn-end {
    width: 110px !important;
    height: 48px !important;
  }
}

@media (max-width: 340px) {
  .image_2 {
    width: 336rpx;
    height: 118rpx;
  }

  .text {
    font-size: 42rpx;
  }

  .info-value.highlight {
    font-size: 38rpx;
  }

  .btn-emergency,
  .btn-end {
    width: 100px !important;
  }
}
