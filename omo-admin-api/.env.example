NODE_ENV=development
PORT=3001
DATA_DRIVER=memory
ADMIN_WEB_ORIGIN=http://localhost:4173
COOKIE_SECURE=false

# Required for DATA_DRIVER=cloudbase. Prefer the CloudBase runtime identity in CloudBase Run.
CLOUDBASE_ENV_ID=replace-with-dev-environment-id
# TENCENTCLOUD_SECRETID=
# TENCENTCLOUD_SECRETKEY=

# Same-environment private health endpoint, for example http://mqtt-bridge-v3/mqtt/health
MQTT_BRIDGE_HEALTH_URL=
MQTT_BRIDGE_INTERNAL_TOKEN=

# Used only by npm run bootstrap:admin. Do not commit actual values.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
