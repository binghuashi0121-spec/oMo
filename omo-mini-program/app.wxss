.font_2,
.font_3,
.font_4,
.font_5,
.font_6 {
  letter-spacing: 0.2rpx;
}

.equal-division-item_2,
.equal-division-item_3 {
  box-shadow: 0rpx 6rpx 10rpx #00000012;
}

