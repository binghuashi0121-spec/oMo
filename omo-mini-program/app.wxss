.login-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(270deg, #f6f2edcc 0%, #e8e0d5cc 50%, #c7c1b8cc 100%);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  z-index: 9999;
}
.login-loader {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 5rpx solid #ef5b24;
  border-top-color: transparent;
  animation: spin 700ms linear infinite;
  margin-bottom: 18rpx;
}
.login-tip {
  color: #494949;
  font-size: 26rpx;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}