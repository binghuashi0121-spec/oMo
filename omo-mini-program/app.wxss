image,
.icon {
  transition: transform 120ms ease-out;
  transform-origin: center center;
}

.oMo-flex-col,
.oMo-flex-row {
  transition: transform 120ms ease-out;
  transform-origin: center center;
}


.tap-press {
  transform: scale(1.16);
}

image.tap-press,
.icon.tap-press {
  transform: scale(1.16);
}

/* Global aesthetic upgrades */
.section,
.section_2,
.section_3,
.section_4,
.section_5,
.section_6,
.section_7 {
  border-radius: 42rpx;
  box-shadow: 0rpx 8rpx 16rpx #0000001a;
