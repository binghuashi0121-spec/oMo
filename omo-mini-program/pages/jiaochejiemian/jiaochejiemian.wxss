}

.top-logo {
  position: absolute;
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  z-index: 5;
}

.map-section {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}

.map-frame {
  position: relative;
  width: 680rpx;
  height: 940rpx;
  border-radius: 48rpx;
  overflow: hidden;
  border: 4px solid #000000;
  box-sizing: border-box;
}

.map-inner {
  width: 100%;
  height: 100%;
}

.map-component {
  width: 100%;
  height: 100%;
}

.car-status-panel {
  position: absolute;
  right: 20rpx;
  top: 40rpx;
  padding: 16rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  min-width: 220rpx;
  max-width: 260rpx;
  z-index: 10;
}

.car-status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 8rpx;
}

.car-status-row:last-child {
  margin-bottom: 0;
}

.car-status-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 8rpx;
  font-weight: 600;
}

.car-status-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 700;
}

