.page {
  padding: 0 20.99rpx 108.78rpx 51.53rpx;
  background-image: linear-gradient(180deg, #e0d4c333 3.4%, #f3a48733 51.4%, #ef5b2433 100%);
  background-repeat: no-repeat;
  background-size: 100% 100%;
  position: relative;
  width: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  height: 100%;
  transition: transform 260ms ease-in, opacity 260ms ease-in;
}

.section {
  box-shadow: none;
  border: none;
}

