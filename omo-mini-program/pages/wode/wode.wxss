.page {
  background-color: #f4f0eb;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding-bottom: 20rpx;
}

.bottom-nav {
  flex-shrink: 0;
  margin-bottom: env(safe-area-inset-bottom);
}

.image-wrapper {
  position: relative;
  padding: 123.44rpx 0 48.32rpx;
  background-color: #efe7dc;
  overflow: hidden;
  box-shadow: none;
  border: none;
}

.image-wrapper::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 24rpx;
  background: linear-gradient(180deg, rgba(198, 190, 181, 0.38) 0%, rgba(220, 214, 207, 0.2) 30%, rgba(244, 240, 235, 0.94) 100%);
  z-index: 1;
}

.image {
