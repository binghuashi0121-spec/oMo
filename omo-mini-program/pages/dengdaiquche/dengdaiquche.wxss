.mt-7 {
  margin-top: 13.36rpx;
}

.page {
  background-color: #f9f9f9ff;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  opacity: 0;
}

.section {
  padding: 22rpx 0 20rpx;
  background-color: #ffffff;
  box-shadow: 0px 4rpx 8rpx #0000000d;
  z-index: 20;
}

.image-wrapper,
.image-wrapper_2 {
  padding: 24rpx 0;
  background-color: #ffffff;
  border-radius: 50%;
  box-shadow: 0px 4rpx 8rpx #0000000d;
  width: 96rpx;
  height: 96rpx;
}

.pos-left {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.pos-right {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.image {
  width: 48rpx;
  height: 48rpx;
}

.image_2 {
  width: 440rpx;
  height: 154rpx;
}

.text {
  color: #000000;
  font-size: 48rpx;
  font-family: Inter;
  font-weight: 600;
  line-height: 44rpx;
}

.section_2 {
  background-color: #ef5b24;
  border-radius: 4rpx;
  width: 244rpx;
  height: 8rpx;
}

.map-area {
  width: 100%;
  height: 300px;
  background-color: #eeeeee;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 20rpx;
  position: relative;
}

.map-frame {
  width: 92%;
  height: 88%;
  border-radius: 32rpx;
  overflow: hidden;
  border: 4rpx solid #000000;
  box-sizing: border-box;
}

.map-inner,
.map-component {
  width: 100%;
  height: 100%;
}

.bottom-panel {
  flex: 1;
  background-color: #ffffff;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  margin-top: -48rpx;
  padding: 40rpx 32rpx 40rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
}

.content-card {
  background-color: #e1d0d0ff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(43, 39, 39, 0.05);
  box-shadow: 0 2rpx 8rpx rgba(11, 10, 10, 0.02);
}

.status-text {
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.info-grid {
  display: flex;
  justify-content: space-between;
}

.info-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.info-value {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.info-value.highlight {
  font-size: 40rpx;
  color: #ef5b24;
  font-weight: bold;
}

.pickup-row {
  margin-top: 22rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
}

.pickup-label {
  color: #666;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.pickup-name {
  color: #333;
  font-size: 26rpx;
  font-weight: 600;
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tips-card {
  background-color: #efe7dc;
}

.tips-main {
  display: block;
  width: 100%;
  color: #000000;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
  white-space: nowrap;
}

.tips-emphasis {
  display: block;
  width: 100%;
  margin-top: 10rpx;
  color: #9a9a9a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  white-space: nowrap;
  margin-left: auto;
  margin-right: auto;
}

.boarding-card {
  background-color: #fff3e8;
}

.boarding-title {
  display: block;
  color: #ef5b24;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.boarding-desc {
  display: block;
  margin-top: 10rpx;
  color: #5a5a5a;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.action-group {
  margin-top: auto;
}

.btn-confirm {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background-color: #1f7a5f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.btn-cancel {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background-color: #ef5b24;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fade-in {
  animation: fadeIn 0.3s ease-out forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
