<view class="oMo-flex-col page">
  <view class="oMo-flex-col section">
    <view class="oMo-flex-col oMo-justify-start oMo-items-start oMo-self-stretch">
      <view class="oMo-flex-col oMo-justify-start oMo-items-center image-wrapper" bind:tap="onClick" hover-class="tap-press">
        <image
          class="image"
          src="../../pictures/fatiao/back.png"
        />
      </view>
    </view>
    <image
      class="oMo-self-center image_2"
      src="../../pictures/fatiao/oMo_logo.png"
    />
  </view>
  <view class="oMo-flex-col oMo-mt-30">
    <view class="oMo-flex-row oMo-justify-between section_2" bind:tap="onClick_1" hover-class="tap-press">
      <view class="oMo-flex-row oMo-items-center oMo-self-center">
        <image
          class="oMo-shrink-0 image"
          src="../../pictures/fatiao/book.png"
        />
        <text class="font ml-15">用车规则</text>
      </view>
      <image
        class="oMo-self-start image_3 image_4"
        src="../../pictures/fatiao/click.png"
      />
    </view>
    <view class="oMo-flex-row oMo-justify-between oMo-items-center section_3 oMo-mt-8" bind:tap="onClick_2" hover-class="tap-press">
      <view class="oMo-flex-row oMo-items-center">
        <image
          class="oMo-shrink-0 image"
          src="../../pictures/fatiao/book.png"
        />
        <text class="font text oMo-ml-10">法律条款及隐私政策</text>
      </view>
      <image
        class="image_3"
        src="../../pictures/fatiao/click.png"
      />
    </view>
  </view>
</view>
