<view class="oMo-flex-col page {{loaded ? 'fade-in' : ''}}">
  <view class="oMo-flex-col section">
    <view class="oMo-flex-row oMo-relative oMo-justify-center oMo-items-center" style="width: 100%;">
      <view class="oMo-flex-col oMo-justify-start oMo-items-center oMo-self-start image-wrapper pos-left" bind:tap="onClick" hover-class="tap-press">
        <image class="image" src="../../pictures/jinxingzhong/home.png" />
      </view>
      <image class="image_2" src="../../pictures/jinxingzhong/oMo_logo.png" />
      <view class="oMo-flex-col oMo-justify-start oMo-items-center image-wrapper_2 pos-right" bind:tap="onClick_1" hover-class="tap-press">
        <image class="image" src="../../pictures/jinxingzhong/help_center.png" />
      </view>
    </view>
    <view class="oMo-flex-col oMo-items-center oMo-mt-16">
      <text class="font text">订单进行中</text>
      <view class="section_2 mt-7"></view>
    </view>
  </view>

  <view class="map-placeholder">
    <view class="map-frame">
      <view class="map-inner">
        <map
          id="progressMap"
          class="map-component"
          latitude="{{mapLatitude}}"
          longitude="{{mapLongitude}}"
          scale="{{mapScale}}"
          markers="{{carMarkers}}"
          polyline="{{trackPolyline}}"
          show-location="true"
        ></map>
      </view>
    </view>
    <view class="parking-banner {{isTempParking ? 'show' : ''}}">
      <view class="parking-status">
        <view class="status-dot"></view>
        <text class="status-text">临时停车中</text>
      </view>
      <text class="parking-timer">{{parkingDurationStr}}</text>
    </view>
  </view>

  <view class="bottom-panel">
    <view class="content-card">
      <view class="info-grid">
        <view class="info-column">
          <text class="info-label">预计收费</text>
          <text class="info-value highlight">¥{{totalFee}}</text>
        </view>
        <view class="info-column">
          <text class="info-label">累计里程</text>
          <text class="info-value highlight">{{totalDistance}}km</text>
        </view>
        <view class="info-column">
          <text class="info-label">剩余电量</text>
          <view class="battery-row">
            <text class="info-value">{{batteryText}}</text>
            <image class="icon-battery" src="../../pictures/jinxingzhong/battery.png" />
          </view>
        </view>
      </view>
      <view class="trip-timer-row">
        <text class="trip-timer-label">累计时长</text>
        <text class="trip-timer-value">{{tripDurationStr}}</text>
      </view>
    </view>

    <view class="content-card">
      <view class="temp-parking-control">
        <view class="temp-switch-row">
          <view class="temp-info">
            <text class="temp-title">临时停车</text>
            <text class="temp-desc">停车期间正常计费，请确保车辆落锁</text>
          </view>
          <switch checked="{{isTempParking}}" bindchange="onTempParkingChange" color="#ef5b24" />
        </view>
      </view>
    </view>

    <view class="content-card">
      <view class="secondary-info">
        <view class="sec-item">
          <text class="sec-label">车辆序号</text>
          <text class="sec-value">{{vehicleSerialText}}</text>
        </view>
        <view class="sec-item">
          <text class="sec-label">续航里程</text>
          <text class="sec-value">{{vehicleRangeText}}</text>
        </view>
        <view class="sec-item">
          <text class="sec-label">核载人数</text>
          <text class="sec-value">{{vehicleCapacityText}}</text>
        </view>
      </view>
    </view>

    <view class="action-group-fixed">
      <button class="btn-emergency" bindtap="onCallHelp" hover-class="tap-press">
        <text>紧急求助</text>
      </button>
      <button class="btn-end" bindtap="onEndTripTap" hover-class="tap-press">
        <text>结束用车</text>
      </button>
    </view>
  </view>

  <view class="modal-overlay {{showEndTripModal ? 'show' : ''}}" catchtouchmove="true">
    <view class="modal-content {{showEndTripModal ? 'slide-up' : ''}}">
      <text class="modal-title">确认结束用车</text>
      <text class="modal-subtitle">请确认车辆已停放在安全区域</text>

      <view class="fee-preview">
        <view class="fee-row">
          <text class="fee-label">当前费用</text>
          <text class="fee-value">¥{{totalFee}}</text>
        </view>
        <view class="fee-tip">最终费用以实际结算为准</view>
      </view>

      <view class="modal-actions">
        <button class="btn-cancel" bindtap="onCancelEndTrip" hover-class="tap-press">继续用车</button>
        <button class="btn-confirm" bindtap="onConfirmEndTrip" hover-class="tap-press">确认结束</button>
      </view>
    </view>
  </view>

  <view class="loading-overlay" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在结算...</text>
  </view>

  <view class="safety-popup-overlay {{showSafetyPopup ? 'show' : ''}}" catchtouchmove="true">
    <view class="safety-popup-content" catchtap="true">
      <image class="safety-icon" src="../../pictures/tanchuang/gantanhao.png" />
      <view class="safety-text-box">
        <text class="safety-text">请确认已检查刹车系统正常，</text>
        <text class="safety-text">车内无遗留物品。</text>
      </view>
      <view class="safety-btn" bindtap="onSafetyCheckConfirm" hover-class="tap-press">
        <text class="safety-btn-text">确认</text>
      </view>
    </view>
  </view>

  <view class="popup-overlay {{showPopup ? 'show' : ''}}" wx:if="{{showPopup}}" bind:tap="onPopupTap">
    <view class="popup-content scale-in" catchtap="true">
      <image class="popup-image" src="../../pictures/tanchuang/gantanhao.png" />
      <view class="popup-text-container">
        <text class="popup-text">临时停车30分钟内未启用</text>
        <text class="popup-text">共享车将自动归还。</text>
        <text class="popup-timer">{{countdownStr}}</text>
      </view>
      <view class="popup-button" bindtap="onPopupTap" hover-class="tap-press">
        <text class="popup-button-text">确定</text>
      </view>
    </view>
  </view>
</view>
