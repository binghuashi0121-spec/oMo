/* Responsive overrides for real-device layout */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx 80rpx;
}

.group {
  padding: 36rpx 0 44rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.section {
  margin-left: 0;
  margin-right: 0;
  padding: 16rpx 28rpx 34rpx;
  box-sizing: border-box;
}

.image-wrapper,
.image-wrapper_2 {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.image_2 {
  width: 100%;
  max-width: 440rpx;
  height: 150rpx;
}

.group_2 {
  padding: 28rpx 0 20rpx;
  align-items: stretch;
}

.vehicle-summary-row {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.vehicle-image {
  width: 320rpx;
  height: 240rpx;
  max-width: 100%;
  margin-right: 0;
  flex: 0 1 320rpx;
}

.info-card {
  width: auto;
  min-width: 0;
  flex: 1 1 320rpx;
  box-sizing: border-box;
  margin-left: 0;
  padding: 24rpx;
  border-radius: 40rpx;
}

.spec-row {
  width: 100%;
  min-height: 64rpx;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.spec-label {
  min-width: 170rpx;
  max-width: 200rpx;
  box-sizing: border-box;
  padding: 10rpx 18rpx;
}

.spec-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  white-space: normal;
  word-break: break-word;
  line-height: 1.35;
}

.info-card .spec-row:first-child .spec-label {
  min-width: 132rpx;
  max-width: 132rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.info-card .spec-row:first-child .spec-value {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: normal;
  font-size: 28rpx;
}

.title-wrapper {
  margin-top: 24rpx;
}

.model-tag {
