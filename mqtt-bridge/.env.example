# ===== MQTT broker =====
MQTT_URL=mqtt://YOUR_BROKER_HOST:1883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_CLIENT_ID=mqtt-bridge-001

# ===== WeChat CloudBase =====
TCB_ENV=YOUR_TCB_ENV_ID
WECHAT_APP_ID=YOUR_WECHAT_APP_ID
# Unknown legacy vehicles fall back to this area; preconfigure every new vehicle explicitly.
DEFAULT_SCENIC_AREA_ID=tianmashan
# Development environments only. Production should leave this false.
ALLOW_WX_DEVTOOLS=false
# Local development only. In CloudBase Run, prefer the workload identity.
TENCENTCLOUD_SECRETID=YOUR_TENCENTCLOUD_SECRETID
TENCENTCLOUD_SECRETKEY=YOUR_TENCENTCLOUD_SECRETKEY

# Optional: keep CloudBase SDK on public API endpoint and skip Tencent
# metadata probing. Recommended in cloud hosting if you see 169.254.0.23 timeouts.
TCB_DISABLE_METADATA_PROBE=true

# ===== HTTP service =====
PORT=3000

# Optional: default is ugv/+/device,ugv/+/response
MQTT_SUB_TOPICS=ugv/+/device,ugv/+/response
